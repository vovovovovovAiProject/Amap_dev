# ========================================
# 智途无忧 - .gitignore
# ========================================

# ========================================
# Python 后端
# ========================================

# 虚拟环境
venv/
.venv/
env/
.env/
ENV/

# 环境变量文件（包含API密钥等敏感信息）
.env
.env.local
.env.*.local
backend/.env

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包/分发
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# ========================================
# 前端
# ========================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建输出
frontend/dist/
frontend/build/

# ========================================
# IDE / 编辑器
# ========================================

# VSCode
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# ========================================
# 操作系统
# ========================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ========================================
# 日志和临时文件
# ========================================

# 日志
*.log
logs/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
.cache/

# ========================================
# 数据库
# ========================================

# SQLite
*.db
*.sqlite
*.sqlite3

# ========================================
# 密钥和证书（重要！）
# ========================================

# API密钥
*api_key*
*apikey*
*secret*
*.pem
*.key
*.crt

# ========================================
# 其他
# ========================================

# Jupyter Notebook
.ipynb_checkpoints/

# 压缩文件
*.zip
*.tar.gz
*.rar

# 测试数据
test_data/
